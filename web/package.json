{
    "name": "infinite-canvas",
    "version": "1.6.330",
    "private": true,
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite --host 0.0.0.0 --port 3000",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "start": "vite preview --host 0.0.0.0 --port 3000",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "electron:dev": "npm run build && electron .",
        "copy:runtime-node": "node electron/copy-runtime-node.cjs",
        "build:agent": "npm --prefix ../canvas-agent install && npm --prefix ../canvas-agent run build && npm --prefix ../canvas-agent prune --omit=dev && npm run copy:runtime-node",
        "fetch:dreamina-cli": "node electron/fetch-dreamina-cli.cjs",
        "fetch:cursor-cli": "node electron/fetch-cursor-cli.cjs",
        "verify:kling-license": "node electron/verify-kling-license.cjs",
        "verify:dreamina-license": "node electron/verify-dreamina-license.cjs",
        "verify:cursor-license": "node electron/verify-cursor-license.cjs",
        "electron:pack": "npm run fetch:cursor-cli && npm run build:agent && npm run build && electron-builder --win",
        "electron:pack:dir": "npm run fetch:cursor-cli && npm run build:agent && npm run build && electron-builder --win dir"
    },
    "dependencies": {
                "send": "^1.2.1",
        "@ant-design/icons": "^6.1.1",
        "@ant-design/pro-components": "3.0.0-beta.3",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@ffmpeg/core": "^0.12.10",
        "@ffmpeg/ffmpeg": "^0.12.15",
        "@ffmpeg/util": "^0.12.2",
        "@tanstack/react-query": "^5.100.9",
        "@uiw/react-codemirror": "^4.25.9",
        "antd": "^6.4.2",
        "axios": "^1.16.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "copy-to-clipboard": "^4.0.2",
        "dayjs": "^1.11.20",
        "fflate": "^0.8.3",
        "file-saver": "^2.0.5",
        "html-to-image": "^1.11.13",
        "https-proxy-agent": "^5.0.1",
        "i18next": "^26.3.6",
        "localforage": "^1.10.0",
        "lucide-react": "^1.16.0",
        "motion": "^12.38.0",
        "nanoid": "^5.1.11",
        "radix-ui": "^1.4.3",
        "rbush": "^4.0.1",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-i18next": "^17.0.11",
        "react-router": "^7.12.0",
        "react-router-dom": "^7.12.0",
        "shadcn": "^4.7.0",
        "streamdown": "^2.5.0",
        "sucrase": "^3.35.1",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4",
        "three": "^0.185.1",
        "tw-animate-css": "^1.4.0",
        "ws": "^8.21.3",
        "xlsx": "^0.18.5",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^20",
        "@types/react": "19.1.12",
        "@types/react-dom": "19.1.9",
        "@vitejs/plugin-react": "^5.2.0",
        "electron": "^37.2.0",
        "electron-builder": "^26.0.12",
        "fake-indexeddb": "^6.2.5",
        "prettier": "^3.8.3",
        "typescript": "^5",
        "vite": "^7.3.0"
    },
    "build": {
        "appId": "com.infinite.canvas.desktop",
        "productName": "InfiniteCanvas",
        "directories": {
            "output": "release"
        },
        "files": [
            "electron/**/*",
            "!electron/runtime/**/*",
            "!electron/cursor-cli/**/*",
            "package.json",
            "node_modules/ws/**/*"
        ],
        "extraResources": [
            {
                "from": "dist",
                "to": "dist"
            },
            {
                "from": "../canvas-agent/dist",
                "to": "canvas-agent/dist"
            },
            {
                "from": "../canvas-agent/node_modules",
                "to": "canvas-agent/node_modules",
                "filter": [
                    "**/*",
                    "!@openai/codex-*/**"
                ]
            },
            {
                "from": "../canvas-agent/package.json",
                "to": "canvas-agent/package.json"
            },
            {
                "from": "../canvas-agent/agent-instructions.md",
                "to": "canvas-agent/agent-instructions.md"
            },
            {
                "from": "../canvas-agent/builtin-skills",
                "to": "canvas-agent/builtin-skills"
            },
            {
                "from": "electron/runtime/node.exe",
                "to": "canvas-agent/node.exe"
            },
            {
                "from": "electron/cursor-cli",
                "to": "cursor-cli"
            },
            {
                "from": "electron/cursor-cli/node_modules",
                "to": "cursor-cli/node_modules",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "asar": true,
        "electronLanguages": [
            "zh-CN",
            "en-US"
        ],
        "icon": "build/icon.ico",
        "electronDownload": {
            "mirror": "https://npmmirror.com/mirrors/electron/"
        },
        "win": {
            "icon": "build/icon.ico",
            "signAndEditExecutable": true,
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "dir",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "deleteAppDataOnUninstall": false,
            "include": "electron/nsis/installer.nsh",
            "installerIcon": "icon.ico",
            "uninstallerIcon": "icon.ico",
            "installerHeaderIcon": "icon.ico",
            "shortcutName": "无限画布",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    },
    "allowScripts": {
        "electron@37.2.0": true
    }
}
