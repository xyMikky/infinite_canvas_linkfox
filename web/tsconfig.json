{
    "compilerOptions": {
        "target": "ES2018",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "incremental": true,
        "paths": {
            "@/*": ["./src/*"],
            "cursor/canvas": ["./src/lib/canvas/cursor-canvas-sdk/index.ts"]
        }
    },
    "include": ["vite.config.ts", "src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["node_modules", "src/lib/canvas/fixtures/**"]
}
